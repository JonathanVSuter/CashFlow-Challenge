{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "API + Worker",
      "configurations": [
        "Launch API",
        "Launch Worker"
      ]
    }
  ],
  "configurations": [
    {
      "name": "Launch API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/CashFlow.Api/bin/Debug/net8.0/CashFlow.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/CashFlow.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Launch Worker",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/CashFlow.Worker/bin/Debug/net8.0/CashFlow.Worker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/CashFlow.Worker",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    }
  ]
}